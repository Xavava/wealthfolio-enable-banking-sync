{
  "id": "enable-banking-sync",
  "name": "Enable Banking Sync",
  "version": "1.4.0",
  "description": "Sync your bank account transactions with one click through Enable Banking (PSD2)",
  "author": "Abel Marin",
  "main": "dist/addon.js",
  "sdkVersion": "3.13.1",
  "minWealthfolioVersion": "3.13.1",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "enable-banking-sync"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "enable-banking-sync",
          "route": "enable-banking-sync",
          "label": "Bank sync",
          "icon": "bank",
          "order": 100
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.enablebanking.com"
    ]
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.13.1",
    "@wealthfolio/ui": "^3.13.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "List your Wealthfolio accounts so you can choose which one each bank account syncs into"
    },
    {
      "category": "activities",
      "functions": [
        "checkImport",
        "import"
      ],
      "purpose": "Validate and import the transactions downloaded from the bank, without duplicating the ones already imported"
    },
    {
      "category": "portfolio",
      "functions": [
        "getLatestValuations"
      ],
      "purpose": "Read each account's balance in Wealthfolio to compare it with the balance the bank reports"
    },
    {
      "category": "secrets",
      "functions": [
        "set",
        "get",
        "use",
        "delete"
      ],
      "purpose": "Store your Enable Banking application's private key encrypted, and the short-lived token that signs the requests"
    },
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "Query banks, authorizations and transactions at api.enablebanking.com"
    },
    {
      "category": "events",
      "functions": [
        "onUpdateComplete"
      ],
      "purpose": "Refresh the balance comparison when Wealthfolio finishes recalculating the portfolio"
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon",
    "enable-banking",
    "psd2",
    "sync",
    "bank",
    "banking"
  ],
  "license": "MIT"
}
